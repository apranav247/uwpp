{
  "name": "uwpp",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "validate": "sam validate --lint",
    "build": "sam build",
    "deploy": "sam build && sam deploy --stack-name uwpp-app --region ap-southeast-2 --resolve-s3 --capabilities CAPABILITY_IAM --no-confirm-changeset --no-fail-on-empty-changeset",
    "seed": "node scripts/seed.js",
    "env": "node scripts/env.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.600.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-eventbridge": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.0.0",
    "esbuild": "^0.21.0",
    "vitest": "^1.6.0"
  }
}
